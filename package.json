    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "maplibre-gl": "6.10.0",
    "pmtiles": "4.5.0"
  }
}
