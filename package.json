{
  "name": "unfallkarte-web",
  "private": true,
  "description": "Frontend der Unfallkarte: Vite (Dev-Server + Build nach dist/) und die Tests (node --test, Playwright gegen den Build).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/mlt": "1.3.0",
    "fzstd": "0.1.1",
    "hyparquet": "1.31.2",
    "maplibre-gl": "6.11.2",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "terra-draw": "1.35.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  }
}
