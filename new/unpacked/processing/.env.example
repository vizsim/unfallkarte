# Kopiere diese Datei nach `.env` (ist via .gitignore ausgeschlossen) und trage
# die echten Werte ein. NIEMALS `.env` committen.

# --- Backblaze B2 (für PMTiles-Upload via upload_pmtiles.sh / `unfallkarte deploy`) ---
# Application Key unter https://secure.backblaze.com/app_keys.htm anlegen und auf
# den Ziel-Bucket beschränken (Read+Write), NICHT den Master-Key benutzen.
# Der applicationKey wird nur einmal angezeigt → direkt hier speichern.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=unfallkarte-data-v2

# --- Mapillary (Map-Feature-Daten / Street-View-Sprung im Viewer) ---
# Der alte, im Repo veröffentlichte Token gilt als kompromittiert → neuen erzeugen.
MAPILLARY_TOKEN=

# MAPTILER_API_KEY entfällt komplett (kein MapTiler mehr).
